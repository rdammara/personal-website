# Cloudflare Pages response headers (the static-hosting replacement for the nginx config)
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # SAMEORIGIN, not DENY: the resume page embeds the resume PDF from this site
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Build output under /_next/static has content hashes in its names, so it never changes
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
